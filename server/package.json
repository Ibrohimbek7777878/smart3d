{
  "name": "smart3d-server",
  "version": "2.1.0",
  "description": "Smart 3D backend — Express + SQLite + WebSocket (ishlaydigan server: index.js)",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "init-db": "node init-db.js",
    "admin-password": "node admin-password.js",
    "test": "node --test \"test/**/*.test.js\"",
    "start:prod": "NODE_ENV=production node index.js",
    "migrate": "psql $DATABASE_URL -f schema.sql",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0"
  },
  "_postgres_variant": {
    "note": "src/server.js (PostgreSQL + Redis) hali ishga tushmaydi — AUDIT-2026-10-14 §5. Kerak bo'lganda: npm i pg ioredis helmet winston zod prom-client uuid express-rate-limit rate-limit-redis",
    "dependencies": [
      "pg",
      "ioredis",
      "helmet",
      "winston",
      "zod",
      "prom-client",
      "uuid",
      "express-rate-limit",
      "rate-limit-redis"
    ]
  }
}
